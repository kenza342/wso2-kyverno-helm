            name: wso2carbon.jks
            password: ""
          primary:
            alias: wso2carbon
            enabled: false
            keyPassword: ""
            name: wso2carbon.jks
            password: ""
          tls:
            alias: wso2carbon
            enabled: true
            keyPassword: wso2carbon
            name: wso2carbon.jks
            password: wso2carbon
        truststore:
