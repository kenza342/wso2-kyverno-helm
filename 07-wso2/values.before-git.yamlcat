          expiryTime: 15m
        jwt_claim:
          enabled: true
          expiryTime: 15m
        km_token:
          enabled: true
          expiryTime: 15m
        publisher_roles:
          enabled: false
        recent_apis:
          enabled: false
        resource:
          enabled: true
          expiryTime: 900s
        scopes:
          enabled: false
        tags:
