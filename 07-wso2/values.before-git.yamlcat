        - POST
        - DELETE
        - PATCH
        - OPTIONS
        allowOrigins:
        - '*'
        enableForWS: false
        enabled: true
      databases:
        apim_db:
          password: ChangeMe_Wso2!
          poolParameters:
            defaultAutoCommit: true
            maxActive: 100
            maxWait: 60000
            minIdle: 5
            testOnBorrow: true
            testWhileIdle: true
            validationInterval: 30000
          url: jdbc:mysql://mysql-svc.wso2.svc.cluster.local:3306/apim_db?useSSL=false
          username: wso2carbon
        jdbc:
          driver: com.mysql.cj.jdbc.Driver
        shared_db:
          password: ChangeMe_Wso2!
          poolParameters:
            defaultAutoCommit: true
            maxActive: 100
            maxWait: 60000
            minIdle: 5
            testOnBorrow: true
            testWhileIdle: true
            validationInterval: 30000
          url: jdbc:mysql://mysql-svc.wso2.svc.cluster.local:3306/apim_db?useSSL=false
