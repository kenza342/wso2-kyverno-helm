        enableKeyProvisioning: null
        enableLegacyApiKeys: false
        enableRatings: null
        loginUsernameCaseInsensitive: null
        mode: HYBRID
        adminUser:
        username: "admin"
        password: "Inetum@Wso2Secure2026!"
        encryption:
        cipherTransformation: AES/GCM/NoPadding
        internalCryptoProvider: org.wso2.carbon.crypto.provider.SymmetricKeyInternalCryptoProvider
        key: "912886127e161a594a6c8f5f630a741d7d6b3be107c646c75343f086bef15dd6"
      eventHandlers:
      - name: userPostSelfRegistration
        subscriptions:
        - POST_ADD_USER
      eventListeners:
